ENVIRONMENT=production
TZ=Asia/Ho_Chi_Minh
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=adminpro
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-password
ALLOWED_ORIGINS=https://your-domain.example
SERVER_DOMAIN=https://your-domain.example
SQLALCHEMY_DATABASE_URL=postgresql://user:password@host:5432/database
REDIS_URL=redis://host:6379/0
QDRANT_URL=https://your-qdrant-host
QDRANT_API_KEY=replace-me
GEMINI_API_KEY=replace-me
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_TEXT_RETRIES=2
GEMINI_EMBED_RETRIES=2
GEMINI_EMBED_CACHE_TTL=604800
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_EXCEL_MAX_OUTPUT_TOKENS=8192
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
ZALO_APP_ID=replace-with-app-id-from-zalo-developers
ZALO_OA_ID=replace-with-official-account-id
# Dán đúng link lấy từ chức năng Chia sẻ/QR của trang quản trị Zalo OA.
# Ví dụ: https://zalo.me/0123456789012345678
ZALO_OA_URL=https://zalo.me/replace-with-public-oa-link
ZALO_ACCESS_TOKEN=replace-me
ZALO_REFRESH_TOKEN=replace-me
ZALO_SECRET_KEY=replace-me
ZALO_WEBHOOK_SECRET=replace-me
ZALO_ADMIN_ID=replace-me
ZALO_ERROR_ALERTS_ENABLED=true
ZALO_NOTIFY_HTTP_4XX=false
ZALO_ERROR_ALERT_COOLDOWN_SECONDS=300
LOG_FILE_PATH=logs/app.log
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
MAX_SEARCH_MEDIA=10
MAX_SEARCH_ROOMS=5
MAX_SEARCH_MEDIA_PER_ROOM=3
QDRANT_TIMEOUT_SECONDS=30
QDRANT_SEARCH_RETRIES=3
